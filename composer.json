{
    "name": "jeroendn/jeroendn-website",
    "description": "My personal website",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-curl": "^8.0",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.9",
        "jeroendn/php-helpers": "^1.0",
        "jeroendn/php-js-console-logger": "^1.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "fakerphp/faker": "^1.24.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.10",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.5",
        "spatie/laravel-ignition": "^2.9",
        "tomasvotruba/bladestan": "^0.11.7"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Helper/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "cs-check": "php-cs-fixer check",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "phpstan-baseline": "phpstan analyse --generate-baseline --memory-limit=2G",
        "phpunit": "phpunit",
        "rector-check": "rector --dry-run",
        "rector-fix": "rector"
    }
}
